# Raw captures — only sanitized excerpts under captures/sanitized are ever committed
captures/raw/*
!captures/raw/.gitkeep
*.pcap
*.pcapng
*.cap
*.har
*.saz
*.etl

# Retail binaries, installed game/depot content
*.exe
*.dll
*.pdb
*.iso
*.wim
*.msi
*.pak
*.map
depots/
depot_*/
*.vpk
*.manifest
steamapps/

# Secrets, credentials, tokens, certificates, keys
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
.env
.env.*
secrets/
credentials/
# Blanket, no extension carve-out: a captured token pasted into a note is the most
# likely leak path, and .md is the format notes are written in. Analysis prose does not
# need "token" in its filename (use docs/AUTH_FLOW.md, not docs/title_token.md). If a
# file genuinely must carry the pattern, `git add -f` makes that an explicit decision.
*token*
*tokens*
*.jwt

# Account exports / personal identifiers
*xuid*
*gamertag*
account_export*

# Local scratch and captured evidence not yet reviewed
scratch/
local/
*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/

# Editor/OS
.vscode/
.idea/
.DS_Store
